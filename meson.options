option(
    'use-ccdb-location',
    type : 'string',
    value : '',
    description : 'Use CCDB installed at this absolute path instead of building the ccdb subproject.',
)

option(
    'use-hipo-location',
    type : 'string',
    value : '',
    description : 'Use HIPO installed at this absolute path instead of building the hipo-cpp subproject.',
)

option(
    'use-clas12-cmag-location',
    type : 'string',
    value : '',
    description : 'Use clas12-cmag installed at this absolute path instead of dependency discovery or '
                + 'building the clas12-cmag subproject.',
)

option(
    'gemc',
    type : 'feature',
    value : 'auto',
    description : 'Resolve an installed GEMC dependency for CLAS12 plugins when available.',
)

option(
    'clas12_sanitize',
    type : 'combo',
    choices : ['none', 'address', 'thread', 'undefined', 'leak'],
    value : 'none',
    description : 'Apply sanitizer flags only to CLAS12 systems targets, not third-party subprojects.',
)

option(
    'use-fields-location',
    type : 'string',
    value : '',
    description : 'Path to an existing CLAS12 magnetic field-maps directory. When set, the build skips '
                + 'fetching the maps (no clone, no magfield subproject) and installs nothing, pointing '
                + 'at this location instead of <prefix>/fields. When empty (default), the maps are taken '
                + 'from the magfield git-lfs subproject and installed under <prefix>/fields.',
)

option(
    'include-subproject-install',
    type : 'boolean',
    value : false,
    description : 'Install bundled subproject libraries, headers, tools, and metadata. Disabled by default '
                + 'because these are build-time dependencies of the CLAS12 plugins, already provided by the '
                + 'installed GEMC.',
)

option(
    'include-subproject-tests',
    type : 'boolean',
    value : false,
    description : 'Build and register bundled subproject tests. Disabled by default so an unqualified '
                + '`meson test` runs only the CLAS12 test suites.',
)
