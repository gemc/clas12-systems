cmake = import('cmake')

sys = host_machine.system()

cmake_opts = cmake.subproject_options()
cmake_opts.add_cmake_defines({
    'BUILD_STATIC_LIBS' : true,
    'BUILD_SHARED_LIBS' : false,
    'ZLIB_USE_STATIC_LIBS' : false,
    'CMAKE_POSITION_INDEPENDENT_CODE' : true,
    'CMAKE_C_STANDARD' : 17,
    'CMAKE_POLICY_VERSION_MINIMUM' : '4.0',
})
cmake_opts.append_compile_args('c',   '-fPIC', '-w')
cmake_opts.append_compile_args('cpp', '-fPIC', '-w')

zlib_dep = dependency('zlib', static : false, required : true)
# Link CLHEP and Geant4 statically (static : true) so the dlopen-able plugins embed only the
# symbols they reference and carry no @rpath/libCLHEP* or @rpath/libG4* dependencies. The shared
# variants resolve to install-name @rpath/... but Meson strips the build-tree rpath at install time
# (no install_rpath is set on the plugin shared_library), which left the installed .gplugin with
# "no LC_RPATH's found" at load. This mirrors gemc's own self-contained gstreamer plugins.
clhep_deps = dependency('clhep', version : '>=2.4.7.1', static : true, include_type : 'system')

# geant4_core.pc is generated by GEMC (the Geant4 install itself ships only G4ptl.pc), so it lives in
# the installed GEMC's lib/pkgconfig. Derive that directory from the gemc binary on PATH so a plain
# "GEMC is installed" setup configures without the caller adding it to PKG_CONFIG_PATH by hand.
gemc_pkgconfig_dir = ''
_gemc_prog = find_program('gemc', required : false)
if _gemc_prog.found()
    _gemc_root = run_command(
        'sh', '-c', 'cd "$(dirname "$(dirname "$1")")" && pwd',
        '_', _gemc_prog.full_path(), check : false,
    ).stdout().strip()
    if _gemc_root != '' and fs.is_dir(_gemc_root / 'lib' / 'pkgconfig')
        gemc_pkgconfig_dir = _gemc_root / 'lib' / 'pkgconfig'
    endif
endif

pkgconfig_prog = find_program('pkg-config', 'pkgconf', required : true)

geant4_core_dep = dependency(
    'geant4_core',
    version      : '>=11.3.2',
    method       : 'pkg-config',
    static       : true,
    include_type : 'system',
    required     : false,
)

if not geant4_core_dep.found() and gemc_pkgconfig_dir != ''
    # Resolve geant4_core.pc straight from the GEMC install. pkg-config is invoked with the GEMC
    # pkgconfig dir prepended (geant4_core.pc has no Requires, so it is self-contained).
    _g4c_env = environment()
    _g4c_env.prepend('PKG_CONFIG_PATH', gemc_pkgconfig_dir)
    _g4c_ver = run_command(
        pkgconfig_prog, '--modversion', 'geant4_core', env : _g4c_env, check : true,
    ).stdout().strip()
    if not _g4c_ver.version_compare('>=11.3.2')
        error('GEMC ships geant4_core ' + _g4c_ver + ' (<11.3.2) in ' + gemc_pkgconfig_dir)
    endif
    _g4c_cflags = run_command(
        pkgconfig_prog, '--cflags', 'geant4_core', env : _g4c_env, check : true,
    ).stdout().split()
    _g4c_libs = run_command(
        pkgconfig_prog, '--libs', '--static', 'geant4_core', env : _g4c_env, check : true,
    ).stdout().split()
    # Pass the Geant4 include dirs as -isystem so their headers stay warning-free (this is what
    # include_type : 'system' does for a pkg-config dependency).
    _g4c_args = []
    foreach _a : _g4c_cflags
        if _a.startswith('-I')
            _g4c_args += ['-isystem', _a.substring(2)]
        else
            _g4c_args += _a
        endif
    endforeach
    message('geant4_core: resolved from GEMC pkgconfig ' + gemc_pkgconfig_dir + ' (' + _g4c_ver + ')')
    geant4_core_dep = declare_dependency(
        compile_args : _g4c_args,
        link_args    : _g4c_libs,
        version      : _g4c_ver,
    )
endif

if not geant4_core_dep.found()
    error(
        'geant4_core not found via pkg-config. Install GEMC (it provides geant4_core.pc) and ensure ' +
        'gemc is on PATH, or add its lib/pkgconfig to PKG_CONFIG_PATH.',
    )
endif

geant4_core_deps = [geant4_core_dep]

gemc_dep = dependency('gemc', required : false, include_type : 'system')
gemc_prefix = ''

if not gemc_dep.found()
    # pkg-config didn't find gemc — try deriving the prefix from the installed binary.
    _gemc_bin = find_program('gemc', required : false)
    if _gemc_bin.found()
        _gemc_prefix = run_command(
            'sh', '-c',
            'cd "$(dirname "$(dirname "$1")")" && pwd',
            '_', _gemc_bin.full_path(),
            check : false,
        ).stdout().strip()
        if _gemc_prefix != ''
            gemc_prefix = _gemc_prefix
            message('gemc: pkg-config not found; falling back to binary prefix ' + _gemc_prefix)
            _gemc_pc_env = environment()
            _gemc_pc_env.prepend('PKG_CONFIG_PATH', _gemc_prefix / 'lib' / 'pkgconfig')
            _gemc_cflags = run_command(
                pkgconfig_prog, '--cflags', 'gemc',
                env : _gemc_pc_env,
                check : true,
            ).stdout().strip().split()
            _gemc_link = run_command(
                pkgconfig_prog, '--libs', 'gemc',
                env : _gemc_pc_env,
                check : true,
            ).stdout().strip().split()
            gemc_dep = declare_dependency(
                include_directories : [include_directories(_gemc_prefix / 'include')],
                compile_args        : _gemc_cflags,
                link_args           : _gemc_link,
            )
        endif
    endif
endif

if not gemc_dep.found()
    error('GEMC is required but was not found via pkg-config or PATH; install GEMC before configuring.')
elif gemc_dep.type_name() == 'pkgconfig'
    gemc_prefix = gemc_dep.get_variable(pkgconfig : 'prefix')
    # Belt-and-suspenders for older installations where .pc Cflags had -I${includedir}/gemc.
    # Adding the parent dir ensures "gemc/module/header.h" style includes always resolve.
    gemc_dep = declare_dependency(
        dependencies        : [gemc_dep],
        include_directories : [include_directories(gemc_dep.get_variable(pkgconfig : 'includedir'))],
    )
endif

gemc_plugin_dep = gemc_dep.partial_dependency(compile_args : true, includes : true)
gemc_gdata_dep = declare_dependency()

if gemc_prefix != ''
    gemc_gdata_dep = declare_dependency(link_args : [gemc_prefix / 'lib' / 'libgdata.a'])
endif

if gemc_prefix != ''
    gemc_geant4_core_pc = gemc_prefix / 'lib' / 'pkgconfig' / 'geant4_core.pc'
    if fs.is_file(gemc_geant4_core_pc)
        gemc_geant4_core_version = run_command(
            'sh', '-c',
            'awk -F: "/^Version:/ {gsub(/^[ \t]+|[ \t]+$/, \"\", \\$2); print \\$2; exit}" "$1"',
            '_', gemc_geant4_core_pc,
            check : true,
        ).stdout().strip()
        if gemc_geant4_core_version != '' and geant4_core_dep.version() != gemc_geant4_core_version
            error(
                'GEMC was built with Geant4 ' + gemc_geant4_core_version +
                ', but Meson found geant4_core ' + geant4_core_dep.version() +
                '. Load matching GEMC/Geant4 modules and reconfigure from a clean build directory.',
            )
        endif
    endif
endif

if sys == 'darwin'
    brew = find_program('brew', required : false)
    if brew.found()
        zstd_prefix = run_command(brew, '--prefix', 'zstd', check : false).stdout().strip()
        openssl_prefix = run_command(brew, '--prefix', 'openssl', check : false).stdout().strip()
        # ccdb's src/CMakeLists.txt unconditionally enables MySQL (-DCCDB_MYSQL) via FindMySQL.cmake,
        # which has no system MySQL to find on a bare macOS host. Homebrew's connectors are keg-only,
        # so point FindMySQL at one through MYSQL_DIR: it locates ${MYSQL_DIR}/bin/{mysql,mariadb}_config
        # and derives the include/lib flags from it (no need to hardcode the client library path/name).
        #
        # Connector choice matters: clasdb.jlab.org authenticates its reader account with
        # mysql_native_password, which Oracle removed from the MySQL client library in 9.0 (the
        # native_password client plugin is compiled out — not a missing .so, not a toggle). A ccdb
        # linked against MySQL 9.x therefore cannot authenticate to clasdb; no ccdb source change can
        # restore a capability removed from the client library. Preference order:
        #   1. mariadb-connector-c — actively maintained, keeps mysql_native_password AND supports
        #      caching_sha2_password, and ccdb's FindMySQL already accepts its mariadb_config.
        #   2. mysql-client@8.4    — Oracle LTS that still ships native_password.
        #   3. mysql-client / mysql — latest; only usable once clasdb migrates to caching_sha2_password.
        # brew --prefix reports a path even for uninstalled formulae, so gate each candidate on
        # fs.is_dir and take the first that is actually installed.
        mysql_prefix = ''
        foreach formula : ['mariadb-connector-c', 'mysql-client@8.4', 'mysql-client', 'mysql']
            if mysql_prefix == ''
                cand = run_command(brew, '--prefix', formula, check : false).stdout().strip()
                if cand != '' and fs.is_dir(cand)
                    mysql_prefix = cand
                    message('Using CCDB MySQL/MariaDB connector prefix (' + formula + '): ' + cand)
                endif
            endif
        endforeach

        if zstd_prefix != ''
            cmake_opts.append_link_args('-L' + zstd_prefix / 'lib')
            message('Using zstd lib dir: ' + zstd_prefix / 'lib')
        endif

        if openssl_prefix != ''
            cmake_opts.append_link_args('-L' + openssl_prefix / 'lib')
            message('Using openssl lib dir: ' + openssl_prefix / 'lib')
        endif

        if mysql_prefix != ''
            cmake_opts.add_cmake_defines({'MYSQL_DIR' : mysql_prefix})
        endif
    endif
endif

ccdb_proj = cmake.subproject('ccdb', options : cmake_opts)
ccdb_dep = ccdb_proj.dependency('ccdb', include_type : 'system')

hipo_cpp_sp = subproject(
    'hipo-cpp',
    default_options : [
        'buildtype=release',
        'default_library=static',
        'cpp_std=c++17',
        'dataframes=false',
        'warning_level=0',
    ],
)
hipo_cpp_dep = hipo_cpp_sp.get_variable('hipo_dep').as_system()

clas12_cmag_dep = dependency('clas12-cmag', include_type : 'system', default_options : ['warning_level=0'])
